# Copy to .env and edit. `docker compose` reads these for ${VAR} substitution.

# Secret key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-please-set-a-real-secret

# Never run production with DEBUG on.
DJANGO_DEBUG=False

# Comma-separated hostnames/IPs that may serve the app (use your domain).
DJANGO_ALLOWED_HOSTS=*

# Comma-separated origins trusted for POST/CSRF, e.g. darood.example.com or
# 203.0.113.10:8085. A bare "host:port" is expanded to http:// and https://.
# Include the port whenever the browser uses one other than 80/443 -- Django
# compares it against the Origin header and a mismatch is a 403 on every POST.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set True only if the reverse proxy sends X-Forwarded-Host / X-Forwarded-Port
# and you would rather have Django read the public host/port from there than
# list origins above. Both are ignored when the proxy doesn't send the headers.
DJANGO_USE_X_FORWARDED_HOST=False
DJANGO_USE_X_FORWARDED_PORT=False

# Set True once you serve over HTTPS (adds secure cookies, HSTS, SSL redirect).
# Requires TLS terminated by a proxy that sets X-Forwarded-Proto.
DJANGO_SECURE_SSL=False

# Host port to expose the app on (container always listens on 8000).
HOST_PORT=8000

# Set to true to load demo users + sample data on first start.
SEED_DEMO=false

# Gunicorn worker processes (rule of thumb: 2 * CPU cores + 1).
WEB_CONCURRENCY=3
